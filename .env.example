# Web Automate — env vars (copy to .env.local for local dev, or set in Vercel Project Settings → Environment Variables)
# NEVER commit real keys. Never paste keys in chat.

# Supabase (leads database) — from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email) — API key from resend.com, "Sending access"
RESEND_API_KEY=

# Anthropic (AI chatbot) — API key from platform.claude.com, created via "Somewhere else"
ANTHROPIC_API_KEY=

# Leads page password — pick any strong password; this is the ONLY password for /leads
LEADS_PASSWORD=

# Owner notification recipients (comma-separated)
OWNER_EMAILS=nalsguson@gmail.com,infowebautomate@gmail.com
